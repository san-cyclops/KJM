<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">
                    <i class="bi bi-people"></i> User Management
                </h1>
                <a href="/admin/users/create" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> Add New User
                </a>
            </div>

            <!-- Alert Messages -->
            <% if (success) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i>
                    <%= success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <% if (error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i>
                            <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                        <% } %>

                            <!-- Users DataGrid -->
                            <div class="card shadow">
                                <div class="card-header">
                                    <h6 class="m-0 font-weight-bold text-primary">
                                        <i class="bi bi-table"></i> Users List
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-striped" id="usersTable">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Username</th>
                                                    <th>Email</th>
                                                    <th>Role</th>
                                                    <th>Created</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (users && users.length> 0) { %>
                                                    <% users.forEach((userItem, index)=> { %>
                                                        <tr>
                                                            <td>
                                                                <%= userItem.id %>
                                                            </td>
                                                            <td>
                                                                <strong>
                                                                    <%= userItem.username %>
                                                                </strong>
                                                                <% if (userItem.id===user.id) { %>
                                                                    <small class="badge bg-info ms-1">You</small>
                                                                    <% } %>
                                                            </td>
                                                            <td>
                                                                <%= userItem.email %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="badge bg-<%= userItem.role === 'admin' ? 'primary' : 'secondary' %>">
                                                                    <%= userItem.role.toUpperCase() %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <small>
                                                                    <%= new
                                                                        Date(userItem.created_at).toLocaleDateString()
                                                                        %>
                                                                </small>
                                                            </td>
                                                            <td>
                                                                <div class="btn-group" role="group">
                                                                    <a href="/admin/users/<%= userItem.id %>/edit"
                                                                        class="btn btn-sm btn-outline-primary"
                                                                        title="Edit User">
                                                                        <i class="bi bi-pencil"></i>
                                                                    </a>

                                                                    <% if (userItem.id !==user.id) { %>
                                                                        <button type="button"
                                                                            class="btn btn-sm btn-outline-danger"
                                                                            onclick="confirmDelete(<%= userItem.id %>, '<%= userItem.username %>')"
                                                                            title="Delete User">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                        <% } %>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                            <% } else { %>
                                                                <tr>
                                                                    <td colspan="6" class="text-center text-muted">
                                                                        <i class="bi bi-inbox"></i> No users found
                                                                    </td>
                                                                </tr>
                                                                <% } %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle text-danger"></i> Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUsername"></strong>?</p>
                <p class="text-danger"><small>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="POST" style="display: inline;">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete User
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(userId, username) {
        document.getElementById('deleteUsername').textContent = username;
        document.getElementById('deleteForm').action = '/admin/users/' + userId;

        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }
</script>